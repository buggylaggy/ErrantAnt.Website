---
import PictureRoll from "vui-web/PictureRoll.astro";
import Tile from "vui-web/Tile.astro";
import TileGroup from "vui-web/TileGroup.astro";
import TileWall from "vui-web/TileWall.astro";
import Banner from "./Banner.astro";
import ComingSoonTile from "./ComingSoonTile.astro";

/** The start page: the banner's tiles, the screenshot tile, then Errant Ant's tiles, in the app's start page style. */
interface Props {
  about: string;
}

const { about } = Astro.props;
// Screenshots of the app, each tinted with its own bar's color.
const screenshots = [
  { src: "/screenshots/start-page.webp", alt: "The Errant Ant start page: tiles for the book in progress, Vocabulary, Map, a pinned board and a pinned word", caption: "Start page", tint: "#f0efeb" },
  { src: "/screenshots/library.webp", alt: "The Library: a wall of book tiles with their covers", caption: "Library", tint: "#e2c9c4" },
  { src: "/screenshots/vocabulary.webp", alt: "Vocabulary: every word with its language and how well it is known", caption: "Vocabulary", tint: "#c2d7d3" },
  { src: "/screenshots/map.webp", alt: "The Map: words linked around their roots, with pen strokes", caption: "Map", tint: "#d1cadc" }
];
// The Map tile's board, drawn like the art's map tiles: word cards as [x, y, width] (26 tall), note pills as
// [x, y, width, height], and the links between them by name.
const mapCards: Record<string, number[]> = { errant: [140, 64, 76], wander: [30, 22, 72], err: [270, 30, 50], error: [252, 104, 58], wanderer: [36, 108, 84] };
const mapPills: Record<string, number[]> = { origin: [168, 14, 30, 16], note: [150, 124, 26, 14] };
const middle = (name: string) => {
  const [x, y, width, height = 26] = mapCards[name] ?? mapPills[name];
  return [x + width / 2, y + height / 2];
};
const mapLinks = [["wander", "errant"], ["origin", "errant"], ["origin", "err"], ["errant", "err"], ["errant", "error"], ["errant", "wanderer"], ["errant", "note"]].map((ends) => ends.map(middle));
---
<TileWall>
  <Banner />

  <TileGroup title="" id="look-inside" full>
    <PictureRoll color="var(--tile-navy)" pictures={screenshots} interval={5000} curtain class="look-inside" />
  </TileGroup>

  <TileGroup title="Coming soon" id="coming-soon">
    <Tile cols={4} rows={2} color="var(--tile-navy)">
      <p class="hero-text">{about}</p>
    </Tile>
    <ComingSoonTile />
    <Tile cols={2} color="var(--tile-steel)" caption="Languages" backCaption="Dictionaries">
      <span class="figure">12</span>
      <span slot="back" class="figure">24</span>
    </Tile>
    <Tile cols={2} color="var(--tile-violet)" title="Local-first" caption="No account · No ads" />
  </TileGroup>

  <TileGroup title="Reading" id="reading">
    <Tile cols={4} rows={2} class="reader-page">
      <p class="reader-title">Pride and Prejudice</p>
      <p class="reader-text">
        It is a truth <span class="word word-new" style="--strength: 45%">universally</span> <span class="word" style="--strength: 34%">acknowledged</span>, that a
        single man in <span class="word" style="--strength: 18%">possession</span> of a good <span class="word" style="--strength: 8%">fortune</span>, must
        be <span class="phrase">in want of</span> a wife.
      </p>
    </Tile>
    <Tile cols={2} color="var(--tile-ochre)" title="EPUB · PDF · TXT" caption="Project Gutenberg" />
    <Tile cols={2} color="var(--tile-red)" title="Paged reading" />
    <Tile cols={4} color="var(--tile-teal)" title="Word panel" caption="Dictionaries · Notes · Sentences" />
  </TileGroup>

  <TileGroup title="Words" id="words">
    <Tile cols={4} rows={2} color="var(--tile-violet)" label="Map" backLabel="Map" backCaption="linked terms">
      <svg class="map-drawing" viewBox="0 0 356 148" aria-hidden="true">
        {mapLinks.map(([[x1, y1], [x2, y2]]) => <line class="map-link" x1={x1} y1={y1} x2={x2} y2={y2} />)}
        {Object.entries(mapCards).map(([word, [x, y, width]]) => (
          <>
            <rect class="map-card" x={x} y={y} width={width} height="26" rx="3" />
            <text class="map-word" x={x + width / 2} y={y + 15}>{word}</text>
            <rect class="map-meaning" x={x + width * 0.29} y={y + 19} width={width * 0.42} height="2.5" rx="1.25" />
          </>
        ))}
        {Object.values(mapPills).map(([x, y, width, height]) => (
          <>
            <rect class="map-pill" x={x} y={y} width={width} height={height} rx={height / 2} />
            <rect class="map-dash" x={x + width * 0.23} y={y + height / 2 - 1.25} width={width * 0.54} height="2.5" rx="1.25" />
          </>
        ))}
      </svg>
      <span slot="back" class="figure">5</span>
    </Tile>
    <Tile cols={2} rows={2} color="var(--tile-olive)" caption="known · 15 of 20" backLabel="Last lookup" backCaption="Pride and Prejudice">
      <span class="term">acknowledged</span>
      <span class="figure">75%</span>
      <span slot="back" class="term">possession</span>
    </Tile>
    <Tile cols={2} color="var(--tile-slate)" title="Vocabulary" caption="Words · Phrases" />
    <Tile cols={2} color="var(--tile-red)" title="Word lists" caption="TXT · CSV · TSV" />
  </TileGroup>

  <TileGroup title="About" id="about">
    <Tile cols={2} color="var(--tile-steel)" title="Privacy policy" href="/privacy/" data-vui-page="privacy" />
  </TileGroup>
</TileWall>
