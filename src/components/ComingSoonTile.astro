---
import Tile from "vui-web/Tile.astro";

/**
 * The Steam tile: a tile-button whose click raises a bottom bar saying Errant Ant is not on Steam yet. The bar sinks
 * again after 3 s; another click starts the wait over.
 */
---
<Tile cols={2} rows={2} color="var(--tile-slate)" title="Steam" caption="Coming soon" button class="coming-soon" />
<p class="notice vui-bar" role="status">Errant Ant is coming soon to Steam.</p>

<script>
  const notice = document.querySelector<HTMLElement>(".notice")!;
  let hide: number | undefined;
  document.querySelector(".coming-soon")!.addEventListener("click", () => {
    notice.classList.add("notice-shown");
    window.clearTimeout(hide);
    hide = window.setTimeout(() => notice.classList.remove("notice-shown"), 3000);
  });
</script>
