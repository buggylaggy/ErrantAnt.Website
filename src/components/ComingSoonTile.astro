---
import Tile from "vui-web/Tile.astro";

/**
 * The page's call to action: a leaf tile-button with the app icon's mascot whose click raises a bottom bar saying
 * Errant Ant is not out yet. The bar sinks again after 3 s; another click starts the wait over.
 */
---
<Tile cols={2} rows={2} color="var(--vui-accent)" title="Coming soon" caption="Windows · Linux" button class="coming-soon">
  <img class="tile-mascot" src="/brand/mascot.webp" alt="" width="512" height="512" decoding="async" />
</Tile>
<p class="notice vui-bar" role="status">Errant Ant isn't out yet. Coming soon to Steam.</p>

<script>
  const notice = document.querySelector<HTMLElement>(".notice")!;
  let hide: number | undefined;
  document.querySelector(".coming-soon")!.addEventListener("click", () => {
    notice.classList.add("notice-shown");
    window.clearTimeout(hide);
    hide = window.setTimeout(() => notice.classList.remove("notice-shown"), 3000);
  });
</script>
